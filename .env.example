# Copia este archivo como .env.local y rellena los valores. Nunca subas .env.local a Git.

# Cadena de conexión de MongoDB Atlas. En Vercel la crea la integración de MongoDB del Marketplace.
# En local puedes dejarla vacía: se usa una base en memoria guardada en .data/ (solo desarrollo).
MONGODB_URI=

# Opcional. Secreto para firmar la sesión del panel: 32 caracteres o más, aleatorio.
# Si falta, el servidor genera uno al azar y lo guarda en la base.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=

# URL pública del sitio. Se usa dentro del código QR de cada cita.
APP_URL=https://nails-art-sc.vercel.app

# Solo para `npm run api` (Express suelto en local): orígenes que pueden llamar a la API, separados por coma.
CORS_ORIGINS=http://localhost:3000

# Puerto de `npm run api`.
API_PORT=4000

# `npm run seed:demo` solo corre si vale exactamente "true". Borra las citas y clientas de la base indicada.
ALLOW_DEMO_SEED=
